# Backend Environment Variables

# === API Keys (Required for AI endpoints) ===
# OpenAI API Key - used for Planner model (GPT-4o)
OPENAI_API_KEY=sk-your-openai-key-here

# OpenAI-compatible base URL (LM Studio)
# Example: http://localhost:1234/v1
OPENAI_BASE_URL=http://localhost:1234/v1

# Groq API Key - used for Executor model (Llama-3.3-70B)
# If not set, falls back to OpenAI (higher cost)
# GROQ_API_KEY=gsk-your-groq-key-here

# === Database (Optional - for future persistence) ===
DATABASE_URL=postgresql://localhost:5432/ayush_habba

# === Model Configuration ===
# Planner model - high intelligence for reasoning
PLANNER_MODEL=gpt-4o

# Executor model - cost-effective for tool execution
# Options: llama-3.3-70b-versatile (Groq), gpt-4o-mini (OpenAI fallback)
EXECUTOR_MODEL=llama-3.3-70b-versatile

# === Application ===
APP_NAME=Ayush Habba
DEBUG=false
