# Backend Environment Variables

# === API Keys (Required for AI endpoints) ===
# OpenAI API Key - used for Planner/Revision/Scoring models
# Required for: /api/v1/chat, /api/v1/chat/debate, /api/v1/generate-plan
OPENAI_API_KEY=sk-your-openai-key-here

# OpenAI-compatible base URL (LM Studio or other local server)
# Example: http://localhost:1234/v1
OPENAI_BASE_URL=http://localhost:1234/v1

# Groq API Key - used for Fast Responder and optional execution
# If not set, falls back to OpenAI (higher cost)
# GROQ_API_KEY=gsk-your-groq-key-here

# === Database (Optional - for future persistence) ===
DATABASE_URL=postgresql://localhost:5432/ayush_habba

# === Model Configuration ===
# Planner model - high intelligence for reasoning
# Used by Clinical Council and Debate Protocol (Ayurveda + Scoring)
PLANNER_MODEL=gpt-4o

# Executor model - cost-effective for tool execution
# Options: llama-3.3-70b-versatile (Groq), gpt-4o-mini (OpenAI fallback)
EXECUTOR_MODEL=llama-3.3-70b-versatile

# === Task-Specific Models (Optional) ===
# Leave blank to fall back to PLANNER_MODEL or EXECUTOR_MODEL

# Clinical Council
COUNCIL_SUPERVISOR_MODEL=
COUNCIL_AGGREGATOR_MODEL=

# Workers
WORKERS_SPECIALIST_MODEL=
# Groq-only fast responder model (OpenAI fallback remains gpt-4o-mini)
WORKERS_FAST_MODEL=

# PER Workflow
PER_PLANNER_MODEL=
PER_EXECUTOR_MODEL=
PER_SYNTHESIZER_MODEL=
PER_REVIEWER_MODEL=

# Debate Council
DEBATE_REVISION_MODEL=
DEBATE_SCORING_MODEL=

# === Application ===
APP_NAME=Ayush Habba
DEBUG=false
